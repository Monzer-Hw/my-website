# Copy to .env.local and fill in. Never commit real values.
# On Vercel these are set per environment (Production and Preview).

# Contact form: Resend API key with sending access (EU region)
RESEND_API_KEY=
# Inbox that receives contact form messages
CONTACT_TO=
# Optional sender, on a domain verified in Resend, e.g. "Monzer Hweit <hello@example.com>".
# Until a domain exists, leave it empty: Resend's test sender (onboarding@resend.dev) is used,
# which can only deliver to the Resend account owner's address.
CONTACT_FROM=
